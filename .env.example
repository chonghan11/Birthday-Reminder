PORT=3000
# memory = no AWS needed, data is lost when the server stops. dynamodb = your real table.
STORAGE_BACKEND=memory
# Needed only when STORAGE_BACKEND=dynamodb:
# TABLE_NAME=<the TableName output printed by cdk deploy>
# AWS_REGION=ap-southeast-1
MAILER_BACKEND=console
CATALOG_BACKEND=curated
LOCAL_SCHEDULER_SECONDS=30
# Reminders are only sent once the birthday person's local time reaches this hour (0-23).
# Set it to 0 locally so you can test without waiting for the morning.
SEND_FROM_HOUR=7
